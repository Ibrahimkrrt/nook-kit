{
  "name": "@nook/kit",
  "version": "1.6.0",
  "description": "The Nook design system and bricks: tokens, components, motion, pixel mascots, Vite preset, Python back-end bricks and shared Claude Code skills.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./icons": "./src/icons.js",
    "./styles.css": "./src/styles/index.css",
    "./vite": "./vite/preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vite",
    "py",
    "skills",
    "templates",
    "bin",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "nook-new-app": "bin/nook-new-app",
    "nook-persona": "bin/nook-persona.mjs",
    "nook-install-skills": "bin/nook-install-skills"
  },
  "scripts": {
    "test": "cd py && python3 -m unittest discover -s tests",
    "check": "d=$(mktemp -d) && NOOK_ROOT=$d NOOK_NO_INSTALL=1 bin/nook-new-app demo Demo >/dev/null && rm -rf $d && echo '\u2714 template scaffolds a valid app'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource/pixelify-sans": "^5.2.5",
    "lucide-react": "^1.70.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": ">=4",
    "motion": ">=12",
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=6"
  }
}
